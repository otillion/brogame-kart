rules_version = '2';

// BroGame Game Kart — قواعد الحماية (Firestore Security Rules)
// هدول القواعد هنن اللي بيمنعوا الغش: ما حدا بيقدر يعدّل نجومه أو يستعمل كود مرتين.
//
// ⚠️ غيّر الإيميل تحت لإيميل جوجل تبع صاحب المحل (ونفس الإيميل بملف index.html → ownerEmails)
// الأرقام تحت (30 ثانية، 15 ساعة، 10 مُهر) لازم تطابق الإعدادات بملف index.html

service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmails() { return ['broogame10@gmail.com']; }

    function signedIn() { return request.auth != null; }

    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ownerEmails();
    }

    function codeDoc(c) { return /databases/$(database)/documents/codes/$(c); }
    function customerDoc(u) { return /databases/$(database)/documents/customers/$(u); }

    // Sections: ps = PlayStation 5, bil = billiards, tt = table tennis, rc = racing.
    // Each section has its own counter: balls.<sec>, free.<sec>, lastAt.<sec>
    function zeros() { return {'ps': 0, 'bil': 0, 'tt': 0, 'rc': 0}; }
    function nulls() { return {'ps': null, 'bil': null, 'tt': null, 'rc': null}; }

    function profileEdit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
    }

    // Older cards (single counter) get the per-section counters added once, all at zero.
    function upgradeCard() {
      return !('balls' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balls', 'free', 'lastAt'])
        && request.resource.data.balls == zeros()
        && request.resource.data.free == zeros()
        && request.resource.data.lastAt == nulls();
    }

    // 15 hours must pass since the last stamp in ANY section.
    function okSince(v) { return v == null || request.time > v + duration.value(15, 'h'); }
    function waitOver(l) { return okSince(l.ps) && okSince(l.bil) && okSince(l.tt) && okSince(l.rc); }

    // One stamp on one section: the code must exist, be unused, younger than 30 s, burned in the same write;
    // the section comes from the code; 15 h since the last stamp anywhere; fewer than 10.
    function earnStar(uid) {
      let b = resource.data;
      let a = request.resource.data;
      let c = a.lastCode;
      let s = get(codeDoc(c)).data.sec;
      return a.diff(b).affectedKeys().hasOnly(['balls', 'lastAt', 'lastCode'])
        && c is string
        && c.matches('^[1-4][0-9]{4}$')
        && s in ['ps', 'bil', 'tt', 'rc']
        && a.balls.diff(b.balls).affectedKeys().hasOnly([s])
        && a.lastAt.diff(b.lastAt).affectedKeys().hasOnly([s])
        && b.balls[s] < 10
        && a.balls[s] == b.balls[s] + 1
        && a.lastAt[s] == request.time
        && waitOver(b.lastAt)
        && get(codeDoc(c)).data.used == false
        && request.time < get(codeDoc(c)).data.createdAt + duration.value(30, 's')
        && getAfter(codeDoc(c)).data.used == true
        && getAfter(codeDoc(c)).data.usedBy == uid;
    }

    // Owner gives the free hour of one section: that counter goes back to 0, free.<sec> + 1.
    function rewardOn(s) {
      let b = resource.data;
      let a = request.resource.data;
      return a.balls.diff(b.balls).affectedKeys().hasOnly([s])
        && a.free.diff(b.free).affectedKeys().hasOnly([s])
        && b.balls[s] >= 10
        && a.balls[s] == 0
        && a.free[s] == b.free[s] + 1;
    }
    function giveReward() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balls', 'free', 'lastRedeemAt'])
        && request.resource.data.lastRedeemAt == request.time
        && (rewardOn('ps') || rewardOn('bil') || rewardOn('tt') || rewardOn('rc'));
    }

    match /customers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'createdAt', 'lastCode', 'balls', 'free', 'lastAt'])
        && request.resource.data.balls == zeros()
        && request.resource.data.free == zeros()
        && request.resource.data.lastAt == nulls()
        && request.resource.data.lastCode == null
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && request.auth.uid == uid && (profileEdit() || upgradeCard() || earnStar(uid));
      allow update: if isOwner() && giveReward();
      allow delete: if isOwner();
    }

    match /codes/{code} {
      allow read, create, delete: if isOwner();
      allow update: if isOwner() || (
        signedIn()
        && resource.data.used == false
        && request.time < resource.data.createdAt + duration.value(30, 's')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && getAfter(customerDoc(request.auth.uid)).data.lastCode == code
        && getAfter(customerDoc(request.auth.uid)).data.lastAt[resource.data.sec] == request.time
      );
    }

    // أي شي تاني ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
